# Database (matches docker-compose.yml; for a native install use your own credentials)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brightloop
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brightloop_test

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720
RESET_TOKEN_EXPIRES_MINUTES=60

# Used to build password reset links
APP_URL=http://localhost:8000

# Optional SMTP. If SMTP_HOST is empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brightloop <no-reply@brightloop.local>

# Set to false to disable the in-process daily billing/renewal scheduler
ENABLE_SCHEDULER=true
